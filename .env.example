# Copy to .env (which is gitignored) and fill in your local values.
# Never commit real secrets.

# Supabase (Postgres)
# Option A (recommended): set host/port/name and let Spring build the JDBC URL.
# The direct host (db.<ref>.supabase.co) is often IPv6-only. If your network can't reach IPv6,
# use the Supabase "Connection pooling" (pooler) host + port shown in the dashboard instead.
SUPABASE_DB_HOST=db.mvuftpomwptrgzchyeoh.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PARAMS=sslmode=require

# For pooler, the username is often like: postgres.<project-ref> (exact value is shown in Supabase UI).
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=CHANGEME

# If you choose the Transaction pooler and you see errors with prepared statements,
# try: SUPABASE_DB_PARAMS=sslmode=require&prepareThreshold=0

# Option B: provide the full JDBC URL directly (overrides the SUPABASE_DB_* vars above)
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.<ref>.supabase.co:5432/postgres?sslmode=require

# Optional: run with Supabase profile
SPRING_PROFILES_ACTIVE=supabase

# --- Supabase REST API mode (no direct DB connection) ---
# Set this profile to run without Postgres (uses HTTPS to PostgREST):
# SPRING_PROFILES_ACTIVE=supabase-api

# Your Supabase project URL (NOT the db host)
SUPABASE_URL=https://mvuftpomwptrgzchyeoh.supabase.co

# Backend-only secret: use the "service_role" key if you want to bypass RLS.
# Never expose this key to the frontend.
SUPABASE_SERVICE_ROLE_KEY=CHANGEME
