# Copy to .env (which is gitignored) and fill in your local values.
# Never commit real secrets.

# Supabase REST API mode (recommended)
# This project supports a REST-based mode that talks to Supabase PostgREST
# and does not require a direct JDBC/Postgres connection. To run in this
# mode set the active Spring profile to `supabase-api`.
# Example (in your shell or .env):
# SPRING_PROFILES_ACTIVE=supabase-api

# Your Supabase project URL (NOT the db host)
SUPABASE_URL=https://mvuftpomwptrgzchyeoh.supabase.co

# Backend-only secret: use the "service_role" key if you need elevated
# privileges on the server side. Never expose this key to the frontend.
SUPABASE_SERVICE_ROLE_KEY=CHANGEME
